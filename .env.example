# ---------------------------------------------------------------------------
# QPrint environment variables
# Copy this file to .env and fill in your own values. Never commit .env.
# Generate a JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
DATABASE_PATH=./server/data/qprint.db

# --- Owner account (read by `npm run init:db`) ----------------------------
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please

# --- Default prices in RM (seeded once, edit later in the dashboard) ------
DEFAULT_PRICE_BW_RM=0.10
DEFAULT_PRICE_COLOUR_RM=0.50

# --- Storage --------------------------------------------------------------
STORAGE_DIR=./storage
BACKUPS_DIR=./backups

# --- Later milestones (safe to leave as-is for now) -----------------------
# Milestone 5: mock | windows | cups
PRINT_DRIVER=mock
PRINTER_NAME=
# Milestone 6 cleanup jobs
FILE_RETENTION_HOURS=24
UNPAID_ORDER_EXPIRY_HOURS=2
MAX_UNPAID_ORDERS_PER_PHONE=3
# Milestone 6 security
SITE_ORIGIN=http://localhost:5173
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
